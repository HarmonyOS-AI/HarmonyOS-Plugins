{
  "name": "harmonyos-ai-plugin-marketplace",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "plugins:create": "node scripts/create-plugin-group.mjs",
    "plugins:sync": "node scripts/sync-manifests.mjs",
    "plugins:validate": "node scripts/validate-plugins.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "evals": "node scripts/run-evals.mjs",
    "evals:live-preview": "node evals/plugins/harmonyos-test-toolkit/skills/harmonyos-live-preview/run.mjs",
    "test:all": "npm test && npm run evals && npm run plugins:validate",
    "plugins:pack": "node scripts/build-distributions.mjs",
    "plugins:release-assets": "node scripts/prepare-release.mjs",
    "evals:one-multi:history": "node evals/plugins/harmonyos-one-multi/historical-audit.mjs",
    "evals:one-multi:compare": "node evals/plugins/harmonyos-one-multi/behavior/compare.mjs"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  }
}
